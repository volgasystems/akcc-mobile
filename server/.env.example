PORT=8787
# Keep empty for public website reads. Account endpoints require the reviewed SQL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MOBILE_ACCOUNTS_ENABLED=false

# Native enquiry/absence forms reuse existing website APIs on explicit Send.
MOBILE_FORMS_ENABLED=true

# Membership forms are native; writes remain off pending backend/staging validation.
MOBILE_MEMBERSHIP_WRITES_ENABLED=false
# Separate approval after durable duplicate-card protection has been validated.
MOBILE_MEMBERSHIP_CARD_ENABLED=false

# Push remains off until SQL, verified account links, APNs/FCM and hosting are ready.
MOBILE_PUSH_ENABLED=false
MOBILE_PUSH_CREDENTIALS_VERIFIED=false
EXPO_PROJECT_ID=
# Server only. Enable enhanced push security in Expo when using this token.
EXPO_ACCESS_TOKEN=
# Server only; at least 32 random characters. Distinct from website payment CRON_SECRET.
MOBILE_PUSH_CRON_SECRET=
