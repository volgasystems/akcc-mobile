# API adapter URL, never the website admin endpoint. HTTPS outside LAN development.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
# Optional account access: enable only AFTER production Auth/RLS and redirects are reviewed.
EXPO_PUBLIC_ACCOUNTS_ENABLED=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Verified web recovery page required. No automatic membership linking.
EXPO_PUBLIC_PASSWORD_RESET_URL=
# Keep false for Expo Go. Enable only for a configured development/production build.
EXPO_PUBLIC_PUSH_ENABLED=false
# Public EAS project UUID from Expo project Settings; never a secret access token.
EXPO_PUBLIC_EXPO_PROJECT_ID=
